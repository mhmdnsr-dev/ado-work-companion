# Required. AES-256-GCM key material for the HttpOnly PAT cookie.
# Generate with: openssl rand -base64 32
# Must be at least 32 characters. Never commit the real value.
ADO_SESSION_SECRET=replace-me-with-openssl-rand-base64-32-output

# Optional: comma-separated origins for credentialed CORS (split frontend/API hosts).
# Same-origin Next.js usage does not need this.
# CORS_ALLOWED_ORIGIN=https://app.example.com,https://admin.example.com,http://localhost:3000

# --- Message me (Resend) ---
# Required to deliver About → Message me emails.
# Create a key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives contact form messages (defaults to author email).
# CONTACT_TO_EMAIL=mhmdnsr.dev@gmail.com

# From address. Use onboarding@resend.dev for testing; use a verified domain in production.
# https://resend.com/domains
# CONTACT_FROM_EMAIL=Azure DevOps Explorer <onboarding@resend.dev>
